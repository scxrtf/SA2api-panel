diff --git a/src/app/globals.css b/src/app/globals.css
index 8da49e4..7355f1d 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -799,6 +799,41 @@ body {
 .uschart-legend button .sum { font-family: var(--mono); color: var(--fg-dim); }
 .uschart-legend button.off { opacity: .4; text-decoration: line-through; }
 .us-empty { text-align: center; color: var(--fg-dim); padding: 34px 10px; font-size: 13px; }
+
+/* ─── 数据看板：分流 Sankey + 模型状态卡 ───────────────────── */
+.an-controls {
+  display: flex; align-items: center; gap: 8px 10px; flex-wrap: wrap;
+}
+.an-controls .ctl-label { font-size: 12px; margin-right: -4px; }
+.an-sankey {
+  background: var(--surface); border: 1px solid var(--border);
+  border-radius: 12px; padding: 8px 10px 4px; overflow-x: auto;
+}
+.an-status-grid {
+  display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px;
+}
+.an-status-card {
+  background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
+  padding: 13px 14px 11px; display: flex; flex-direction: column; gap: 5px;
+  transition: border-color .15s, box-shadow .15s;
+}
+.an-status-card:hover { border-color: var(--border-soft); box-shadow: 0 1px 4px rgba(58, 58, 64, .07); }
+.an-status-card .pct {
+  font-family: var(--mono); font-size: 26px; font-weight: 700; line-height: 1.1;
+  letter-spacing: -.5px;
+}
+.an-status-card .nm { font-weight: 600; font-size: 13.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.an-status-card .src { font-size: 11.5px; }
+.an-status-card .hb-row { display: flex; gap: 2px; margin-top: 3px; }
+.an-status-card .hb-row i {
+  flex: 1 1 0; height: 14px; border-radius: 1.5px; min-width: 0;
+}
+.an-status-card .hb-row i.up { background: var(--ok); }
+.an-status-card .hb-row i.down { background: var(--err); }
+.an-status-card .hb-meta { font-size: 11px; }
+.an-status-card .hb-foot {
+  display: flex; justify-content: space-between; font-size: 11px; margin-top: 1px;
+}
 .us-mix {
   display: flex; height: 3px; border-radius: 2px; overflow: hidden;
   background: var(--bg-soft); margin-top: 5px; min-width: 60px;
