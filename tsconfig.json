{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".runtime/workspace-qa/traffic-dev/types/**/*.ts",
    ".runtime/workspace-qa/traffic-dev/dev/types/**/*.ts",
    ".runtime/workspace-qa/traffic-verify/types/**/*.ts",
    ".runtime/workspace-qa/traffic-verify/dev/types/**/*.ts",
    ".runtime/verify-open-panel/types/**/*.ts",
    ".runtime/verify-open-panel/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "workers/workspace"
  ]
}
